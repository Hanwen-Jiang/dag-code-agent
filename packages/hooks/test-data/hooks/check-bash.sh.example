#!/bin/bash
# Example PreToolUse hook: Block production environment operations
# Reference: Chapter 32.5 of AI Agent Architecture
#
# Protocol:
# - Reads JSON from stdin (EventPayload)
# - Extracts bash command from tool_input.command
# - exit 0 = allow, exit 2 = deny (stderr contains rejection reason)

set -e

# Parse JSON input
INPUT=$(cat)
COMMAND=$(echo "$INPUT" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d['tool_input'].get('command', ''))")

# Check for dangerous patterns
if echo "$COMMAND" | grep -qiE "prod.*\.env|\.env\.production|^rm\s+-rf\s+/\|^dd\s+if=.*of=/dev/"; then
    echo "Denied: Operations on production environment files are not permitted by security policy." >&2
    exit 2
fi

# Allow safe commands
exit 0
