HARNESS_MODE=server
HARNESS_ADDR=127.0.0.1:8080
HARNESS_DB_PATH=.data/harness.sqlite
HARNESS_WORKSPACE_ROOT=.

# Chat provider. Leave provider=local for the offline adapter.
# For DeepSeek, use: provider=openai-compatible, base URL=https://api.deepseek.com, model=deepseek-chat.
HARNESS_MODEL_PROVIDER=local
HARNESS_MODEL_BASE_URL=
HARNESS_MODEL_API_KEY=
HARNESS_MODEL_NAME=deepseek-chat
HARNESS_MODEL_REASONING_EFFORT=low
HARNESS_MODEL_TIMEOUT_SECONDS=90
